{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dhip-2027/schemas/insurance-group.schema.json",
  "title": "Insurance Group",
  "description": "Corporate organisation. Legal identity and ownership remain unknown until evidenced.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "legal_entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownership_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "rating",
        "explanation",
        "claim_ids",
        "limitations",
        "confidence",
        "last_verified"
      ]
    },
    "provider_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "partially_verified",
        "verified"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "group_id",
    "name",
    "legal_entity",
    "ownership_summary",
    "assessment",
    "provider_ids",
    "verification_status",
    "notes"
  ]
}
