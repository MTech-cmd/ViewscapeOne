{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dhip-2027/schemas/research-source.schema.json",
  "title": "Research Source",
  "description": "Evidence source that may support multiple claims. Res review required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "checked_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary",
        "regulatory",
        "academic",
        "independent_assessment",
        "news",
        "corporate_statement",
        "other",
        "unknown"
      ]
    },
    "evidence_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "source_id",
    "title",
    "publisher",
    "url",
    "publication_date",
    "checked_date",
    "source_type",
    "evidence_summary",
    "limitations",
    "confidence",
    "claim_ids",
    "notes"
  ]
}
