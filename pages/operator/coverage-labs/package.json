{
  "name": "coverage-labs",
  "version": "0.1.4+milestone.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm test && npm run check:links",
    "build:search": "node scripts/build-search-index.mjs",
    "pretest": "npm run build:search && npm run build:offline",
    "build:offline": "node scripts/build-offline-manifest.mjs"
  }
}
